+[Fact]
+public async Task CrossDocumentTopLevelEditShouldProduceFreshModel_CSharp()
+{
+    var consumerSource = """
+        class Consumer
+        {
+            void M(ProbeTarget target)
+            {
+                _ = target;
+            }
+        }
+        """;
+
+    var targetV1Source = """
+        class ProbeTarget
+        {
+            public int ProbeDiskMember { get; }
+        }
+        """;
+
+    var targetV2Source = """
+        class ProbeTarget
+        {
+            public int ProbeUnsavedMember { get; }
+        }
+        """;
+
+    var consumerSeed = CreateDocument(consumerSource, LanguageNames.CSharp);
+    var consumerId = consumerSeed.Id;
+
+    var targetV1 = consumerSeed.Project.AddDocument(
+        "Target.cs",
+        SourceText.From(targetV1Source));
+
+    var consumerV1 = targetV1.Project.GetDocument(consumerId);
+    Assert.NotNull(consumerV1);
+
+    var position = consumerSource.IndexOf("target;");
+
+    // Prime the workspace semantic-model reuse map from v1.
+    var reusedModelV1 = await consumerV1.ReuseExistingSpeculativeModelAsync(
+        position,
+        CancellationToken.None);
+
+    Assert.False(reusedModelV1.IsSpeculativeSemanticModel);
+
+    var consumerTreeV1 = await consumerV1.GetSyntaxTreeAsync();
+    var semanticVersionV1 = await consumerV1.Project.GetDependentSemanticVersionAsync(
+        CancellationToken.None);
+
+    // Change only Target. Consumer source/tree remains untouched.
+    var targetV2 = targetV1.WithText(SourceText.From(targetV2Source));
+    var consumerV2 = targetV2.Project.GetDocument(consumerId);
+    Assert.NotNull(consumerV2);
+
+    var consumerTreeV2 = await consumerV2.GetSyntaxTreeAsync();
+    var semanticVersionV2 = await consumerV2.Project.GetDependentSemanticVersionAsync(
+        CancellationToken.None);
+
+    // Consumer itself was not changed, so its SyntaxTree object should be retained.
+    Assert.Same(consumerTreeV1, consumerTreeV2);
+
+    // The project semantic world did change because Target changed at top level.
+    Assert.NotEqual(semanticVersionV1, semanticVersionV2);
+
+    // Materialize and verify the current v2 compilation/model.
+    var currentCompilationV2 = await consumerV2.Project.GetCompilationAsync(
+        CancellationToken.None);
+
+    Assert.NotNull(currentCompilationV2);
+
+    var currentModelV2 = await consumerV2.GetSemanticModelAsync(
+        CancellationToken.None);
+
+    Assert.NotNull(currentModelV2);
+    Assert.Same(currentCompilationV2, currentModelV2.Compilation);
+
+    // Ask the semantic-model reuse service for Consumer again.
+    var reusedModelV2 = await consumerV2.ReuseExistingSpeculativeModelAsync(
+        position,
+        CancellationToken.None);
+
+    // After a cross-document top-level semantic change, reuse must return
+    // a fresh semantic model rooted in the current v2 compilation.
+    Assert.False(reusedModelV2.IsSpeculativeSemanticModel);
+    Assert.NotSame(reusedModelV1, reusedModelV2);
+    Assert.Same(currentCompilationV2, reusedModelV2.Compilation);
+
+    var reusedProbeTarget =
+        reusedModelV2.Compilation.GetTypeByMetadataName("ProbeTarget");
+
+    var currentProbeTarget =
+        currentCompilationV2.GetTypeByMetadataName("ProbeTarget");
+
+    Assert.NotNull(reusedProbeTarget);
+    Assert.NotNull(currentProbeTarget);
+
+    Assert.Contains(
+        reusedProbeTarget.GetMembers(),
+        member => member.Name == "ProbeUnsavedMember");
+
+    Assert.DoesNotContain(
+        reusedProbeTarget.GetMembers(),
+        member => member.Name == "ProbeDiskMember");
+
+    Assert.Contains(
+        currentProbeTarget.GetMembers(),
+        member => member.Name == "ProbeUnsavedMember");
+
+    Assert.DoesNotContain(
+        currentProbeTarget.GetMembers(),
+        member => member.Name == "ProbeDiskMember");
+}
+
