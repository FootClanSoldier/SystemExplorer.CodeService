+﻿// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System;
+using System.Collections.Immutable;
+using System.IO;
+using System.Linq;
+
+namespace Microsoft.CodeAnalysis;
+
+/// <summary>
+/// Immutable SystemExplorer completion-only source exclusion configuration.  Prefix normalization is owned by the
+/// language-server initialize path; this type canonicalizes set identity and performs allocation-free document-path
+/// classification in completion projection hot paths.
+/// </summary>
+internal sealed class SystemExplorerCompletionSourcePathExclusions
+{
+    private const string ChecksumIdentity = "SystemExplorerCompletionSourcePathExclusions/v1";
+
+    private static readonly StringComparison s_pathComparison =
+        Path.DirectorySeparatorChar == '\\' ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;
+
+    private static readonly StringComparer s_pathComparer =
+        Path.DirectorySeparatorChar == '\\' ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal;
+
+    public static readonly SystemExplorerCompletionSourcePathExclusions Empty = new([]);
+
+    private readonly ImmutableArray<string> _excludedPathPrefixes;
+
+    public bool IsEmpty => _excludedPathPrefixes.IsEmpty;
+
+    public Checksum Checksum { get; }
+
+    public SystemExplorerCompletionSourcePathExclusions(ImmutableArray<string> excludedPathPrefixes)
+    {
+        if (excludedPathPrefixes.IsDefault)
+            throw new ArgumentException("Excluded path prefixes must be initialized.", nameof(excludedPathPrefixes));
+
+        _excludedPathPrefixes = excludedPathPrefixes
+            .Distinct(s_pathComparer)
+            .OrderBy(static prefix => prefix, s_pathComparer)
+            .ToImmutableArray();
+
+        Checksum = CreateChecksum(_excludedPathPrefixes);
+    }
+
+    public bool MatchesNormalizedPrefixes(ImmutableArray<string> excludedPathPrefixes)
+    {
+        if (excludedPathPrefixes.IsDefault || excludedPathPrefixes.Length != _excludedPathPrefixes.Length)
+            return false;
+
+        for (var i = 0; i < _excludedPathPrefixes.Length; i++)
+        {
+            if (!s_pathComparer.Equals(_excludedPathPrefixes[i], excludedPathPrefixes[i]))
+                return false;
+        }
+
+        return true;
+    }
+
+    public bool IsEquivalentTo(SystemExplorerCompletionSourcePathExclusions other)
+    {
+        if (Checksum != other.Checksum || _excludedPathPrefixes.Length != other._excludedPathPrefixes.Length)
+            return false;
+
+        for (var i = 0; i < _excludedPathPrefixes.Length; i++)
+        {
+            if (!s_pathComparer.Equals(_excludedPathPrefixes[i], other._excludedPathPrefixes[i]))
+                return false;
+        }
+
+        return true;
+    }
+
+    public bool IsExcludedSourcePath(string? filePath)
+    {
+        if (string.IsNullOrEmpty(filePath) || _excludedPathPrefixes.IsEmpty)
+            return false;
+
+        foreach (var excludedPathPrefix in _excludedPathPrefixes)
+        {
+            if (filePath.StartsWith(excludedPathPrefix, s_pathComparison))
+                return true;
+        }
+
+        return false;
+    }
+
+    private static Checksum CreateChecksum(ImmutableArray<string> excludedPathPrefixes)
+    {
+        var checksumValues = s_pathComparison == StringComparison.OrdinalIgnoreCase
+            ? excludedPathPrefixes.Select(static prefix => prefix.ToUpperInvariant()).Prepend(ChecksumIdentity)
+            : excludedPathPrefixes.Prepend(ChecksumIdentity);
+
+        return Microsoft.CodeAnalysis.Checksum.Create(checksumValues);
+    }
+}
