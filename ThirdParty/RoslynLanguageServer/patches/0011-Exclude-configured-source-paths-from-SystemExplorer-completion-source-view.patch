+using System;
+using System.Collections.Immutable;
+using System.IO;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Microsoft.CodeAnalysis.Shared.Extensions;
+using Microsoft.CodeAnalysis.Test.Utilities;
+using Microsoft.CodeAnalysis.Text;
+using Roslyn.Test.Utilities;
+using Xunit;
+
+namespace Microsoft.CodeAnalysis.UnitTests;
+
+[UseExportProvider]
+[Trait(Traits.Feature, Traits.Features.Workspace)]
+public sealed class SystemExplorerCompletionSourceProjectionTests : TestBase
+{
+    [Fact]
+    public async Task CompletionProjectionRemovesExcludedOrdinarySourceWithoutChangingOriginalSolutionAsync()
+    {
+        using var workspace = SolutionTestHelpers.CreateWorkspace();
+        var projectId = ProjectId.CreateNewId();
+        var includedDocumentId = DocumentId.CreateNewId(projectId);
+        var excludedDocumentId = DocumentId.CreateNewId(projectId);
+        var additionalDocumentId = DocumentId.CreateNewId(projectId);
+        var analyzerConfigDocumentId = DocumentId.CreateNewId(projectId);
+
+        var testRoot = Path.GetFullPath("SystemExplorerCompletionSourceProjection");
+        var excludedRoot = Path.Combine(testRoot, "addons", "system_explorer");
+        var includedPath = Path.Combine(testRoot, "Scripts", "Included.cs");
+        var excludedPath = Path.Combine(excludedRoot, "Internal.cs");
+        var additionalPath = Path.Combine(excludedRoot, "completion-data.txt");
+        var analyzerConfigPath = Path.Combine(excludedRoot, ".editorconfig");
+
+        var originalSolution = workspace.CurrentSolution
+            .AddProject(projectId, "ProjectionTests", "ProjectionTests", LanguageNames.CSharp)
+            .AddDocument(includedDocumentId, "Included.cs", SourceText.From("public class Included { }", Encoding.UTF8), filePath: includedPath)
+            .AddDocument(excludedDocumentId, "Internal.cs", SourceText.From("public class Internal { }", Encoding.UTF8), filePath: excludedPath)
+            .AddAdditionalDocument(additionalDocumentId, "completion-data.txt", SourceText.From("data", Encoding.UTF8), filePath: additionalPath)
+            .AddAnalyzerConfigDocument(analyzerConfigDocumentId, ".editorconfig", SourceText.From("root = true", Encoding.UTF8), filePath: analyzerConfigPath);
+
+        var exclusions = new SystemExplorerCompletionSourcePathExclusions(
+            ImmutableArray.Create(NormalizeDirectoryPrefix(excludedRoot)));
+
+        var originalCompilation = await originalSolution.GetRequiredProject(projectId).GetRequiredCompilationAsync(CancellationToken.None);
+        Assert.Contains(originalCompilation.SyntaxTrees, tree => PathsEqual(tree.FilePath, excludedPath));
+
+        var projectedSolution = originalSolution.WithSystemExplorerCompletionSourceExclusions(exclusions, CancellationToken.None);
+        var projectedCompilation = await projectedSolution.GetRequiredProject(projectId).GetRequiredCompilationAsync(CancellationToken.None);
+
+        Assert.NotNull(projectedSolution.GetDocument(includedDocumentId));
+        Assert.Null(projectedSolution.GetDocument(excludedDocumentId));
+        Assert.NotNull(projectedSolution.GetAdditionalDocument(additionalDocumentId));
+        Assert.NotNull(projectedSolution.GetAnalyzerConfigDocument(analyzerConfigDocumentId));
+        Assert.DoesNotContain(projectedCompilation.SyntaxTrees, tree => PathsEqual(tree.FilePath, excludedPath));
+
+        // The full workspace/source authority remains unchanged.  Only the completion projection loses this source.
+        Assert.NotNull(originalSolution.GetDocument(excludedDocumentId));
+        Assert.Contains(originalCompilation.SyntaxTrees, tree => PathsEqual(tree.FilePath, excludedPath));
+    }
+
+    [Fact]
+    public void CompletionProjectionCacheIsScopedToSolutionSnapshotAndExclusionChecksum()
+    {
+        using var workspace = SolutionTestHelpers.CreateWorkspace();
+        var projectId = ProjectId.CreateNewId();
+        var includedDocumentId = DocumentId.CreateNewId(projectId);
+        var excludedDocumentId = DocumentId.CreateNewId(projectId);
+
+        var testRoot = Path.GetFullPath("SystemExplorerCompletionSourceProjectionCache");
+        var excludedRoot = Path.Combine(testRoot, "addons", "system_explorer");
+        var otherExcludedRoot = Path.Combine(testRoot, "OtherExcluded");
+        var includedPath = Path.Combine(testRoot, "Scripts", "Included.cs");
+        var excludedPath = Path.Combine(excludedRoot, "Internal.cs");
+
+        var solution = workspace.CurrentSolution
+            .AddProject(projectId, "ProjectionCacheTests", "ProjectionCacheTests", LanguageNames.CSharp)
+            .AddDocument(includedDocumentId, "Included.cs", SourceText.From("public class Included { }", Encoding.UTF8), filePath: includedPath)
+            .AddDocument(excludedDocumentId, "Internal.cs", SourceText.From("public class Internal { }", Encoding.UTF8), filePath: excludedPath);
+
+        var exclusions = new SystemExplorerCompletionSourcePathExclusions(
+            ImmutableArray.Create(NormalizeDirectoryPrefix(excludedRoot)));
+        var equivalentExclusions = new SystemExplorerCompletionSourcePathExclusions(
+            ImmutableArray.Create(NormalizeDirectoryPrefix(excludedRoot)));
+        var otherExclusions = new SystemExplorerCompletionSourcePathExclusions(
+            ImmutableArray.Create(NormalizeDirectoryPrefix(otherExcludedRoot)));
+
+        var firstProjection = solution.WithSystemExplorerCompletionSourceExclusions(exclusions, CancellationToken.None);
+        var secondProjection = solution.WithSystemExplorerCompletionSourceExclusions(equivalentExclusions, CancellationToken.None);
+        Assert.Same(firstProjection, secondProjection);
+
+        // A projected snapshot recognizes its own checksum and must not scan/project a second time.
+        Assert.Same(
+            firstProjection,
+            firstProjection.WithSystemExplorerCompletionSourceExclusions(equivalentExclusions, CancellationToken.None));
+
+        var changedSolution = solution.WithDocumentText(includedDocumentId, SourceText.From("public class IncludedChanged { }", Encoding.UTF8));
+        var changedProjection = changedSolution.WithSystemExplorerCompletionSourceExclusions(exclusions, CancellationToken.None);
+        Assert.NotSame(firstProjection, changedProjection);
+
+        var differentExclusionProjection = solution.WithSystemExplorerCompletionSourceExclusions(otherExclusions, CancellationToken.None);
+        Assert.NotSame(firstProjection, differentExclusionProjection);
+    }
+
+    private static string NormalizeDirectoryPrefix(string path)
+        => Path.GetFullPath(path).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
+
+    private static bool PathsEqual(string? left, string right)
+        => string.Equals(
+            left,
+            right,
+            Path.DirectorySeparatorChar == '\\' ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal);
+}
