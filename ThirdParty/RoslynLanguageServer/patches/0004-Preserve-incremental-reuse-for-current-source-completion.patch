+    [Fact]
+    public async Task GettingCompletionListAfterWarmSourceEditDoesNotRerunSourceGenerator()
+    {
+        const string targetV1 = "class Target { public int ProbeDiskMember { get; } }";
+        const string targetV2 = "class Target { public int ProbeUnsavedMember { get; } }";
+        var consumerMarkup = """
+            class Consumer
+            {
+                void M(Target target)
+                {
+                    target.$$
+                }
+            }
+            """;
+        MarkupTestFile.GetPosition(consumerMarkup.NormalizeLineEndings(), out var consumerSource, out int? position);
+
+        var generatorRanCount = 0;
+        var generator = new CallbackGenerator(onInit: _ => { }, onExecute: _ => Interlocked.Increment(ref generatorRanCount));
+
+        using var workspace = WorkspaceTestUtilities.CreateWorkspaceWithPartialSemantics();
+        var project = SolutionUtilities.AddEmptyProject(workspace.CurrentSolution)
+            .AddAnalyzerReference(new TestGeneratorReference(generator))
+            .AddDocument("Target.cs", targetV1, filePath: "Target.cs").Project
+            .AddDocument("Consumer.cs", consumerSource, filePath: "Consumer.cs").Project;
+
+        Assert.True(workspace.SetCurrentSolution(_ => project.Solution, WorkspaceChangeKind.SolutionChanged));
+
+        var initialProject = workspace.CurrentSolution.Projects.Single();
+        Assert.NotNull(await initialProject.GetCompilationAsync());
+        var generatorRanCountAfterWarmup = generatorRanCount;
+        Assert.True(generatorRanCountAfterWarmup > 0);
+
+        var targetDocumentId = initialProject.Documents.Single(static document => document.Name == "Target.cs").Id;
+        var consumerDocumentId = initialProject.Documents.Single(static document => document.Name == "Consumer.cs").Id;
+        var changedSolution = workspace.CurrentSolution.WithDocumentText(
+            targetDocumentId, SourceText.From(targetV2), PreservationMode.PreserveIdentity);
+        Assert.True(workspace.SetCurrentSolution(_ => changedSolution, WorkspaceChangeKind.SolutionChanged));
+
+        var consumerDocument = workspace.CurrentSolution.GetRequiredDocument(consumerDocumentId);
+        var completionService = consumerDocument.GetLanguageService<CompletionService>();
+        var completionList = await completionService.GetCompletionsAsync(
+            consumerDocument, position.Value, CompletionOptions.Default, OptionSet.Empty);
+        var labels = completionList.ItemsList.Select(static item => item.DisplayText).ToImmutableHashSet();
+
+        Assert.Equal(generatorRanCountAfterWarmup, generatorRanCount);
+        Assert.Contains("ProbeUnsavedMember", labels);
+        Assert.DoesNotContain("ProbeDiskMember", labels);
+    }
 }
