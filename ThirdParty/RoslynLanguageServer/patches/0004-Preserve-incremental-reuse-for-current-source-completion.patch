+
+        public RegularCompilationTracker WithDoNotCreateCreationPolicyForCompletion()
+        {
+            var state = this.ReadState();
+
+            // Completion only changes the warm/in-progress behavior.  Final and cold/null states intentionally keep
+            // the exact legacy DoNotCreate semantics, including the cold parsed-tree preservation path.
+            if (state is not InProgressState inProgressState)
+                return WithDoNotCreateCreationPolicy();
+
+            // Keep the current ProjectState and the existing pending translation chain.  When this cloned tracker is
+            // later asked for a compilation, CollapseInProgressStateAsync can apply those already-recorded incremental
+            // translations instead of snapping back to the first OldProjectState and discarding the chain.
+            return new RegularCompilationTracker(
+                this.ProjectState,
+                new InProgressState(
+                    CreationPolicy.DoNotCreate,
+                    inProgressState.LazyCompilationWithoutGeneratedDocuments,
+                    inProgressState.GeneratorInfo,
+                    inProgressState.LazyStaleCompilationWithGeneratedDocuments,
+                    inProgressState.PendingTranslationActions),
+                skeletonReferenceCacheToClone: _skeletonReferenceCache);
