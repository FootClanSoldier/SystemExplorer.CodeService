+﻿// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System.Collections.Immutable;
+
+namespace Microsoft.CodeAnalysis.Completion.Providers;
+
+internal static class SystemExplorerCompletionMethodShape
+{
+    internal const string MethodHasParametersPropertyKey = "SystemExplorer.CompletionMethodHasParameters";
+
+    public static CompletionItem Attach(
+        CompletionItem item,
+        ImmutableArray<ISymbol> symbols)
+    {
+        if (symbols.IsDefaultOrEmpty)
+            return item;
+
+        var hasParameters = false;
+        foreach (var symbol in symbols)
+        {
+            if (symbol is not IMethodSymbol method)
+                return item;
+
+            if (method.Parameters.Length > 0)
+                hasParameters = true;
+        }
+
+        return item.AddProperty(
+            MethodHasParametersPropertyKey,
+            hasParameters ? bool.TrueString : bool.FalseString);
+    }
+}
