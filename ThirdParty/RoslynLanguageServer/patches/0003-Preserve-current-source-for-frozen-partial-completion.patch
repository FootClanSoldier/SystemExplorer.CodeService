+    /// <summary>
+    /// Creates a completion-specific frozen-partial document that preserves the current tracked ordinary source
+    /// state for the requesting project's same-language compilation dependency closure.  Unlike the legacy frozen
+    /// partial API, this path deliberately restores more than the requesting document so completion does not bind a
+    /// current document against stale or absent ordinary source from the same compilation graph.
+    /// </summary>
+    internal Document WithFrozenPartialSemanticsForCompletion(CancellationToken cancellationToken)
+    {
+        // Source-generated documents retain the legacy behavior.  Completion's current-source contract applies to
+        // tracked ordinary source only and must not force generators to run.
+        if (this is SourceGeneratedDocument)
+            return this;
+
+        // Preserve the existing fast path when this exact project snapshot already has a complete compilation.
+        if (this.Project.TryGetCompilation(out _))
+            return this;
+
+        var solution = this.Project.Solution;
+        if (solution.PartialSemanticsEnabled && this.Project.SupportsCompilation)
+        {
+            var newSolution = solution.WithFrozenPartialCompilationIncludingSpecificDocumentForCompletion(this.Id, cancellationToken);
+            return newSolution.GetRequiredDocument(this.Id);
+        }
+
+        return this;
+    }
