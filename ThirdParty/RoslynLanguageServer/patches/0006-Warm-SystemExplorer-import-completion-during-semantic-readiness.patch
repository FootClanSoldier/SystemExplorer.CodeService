+    [Theory, CombinatorialData]
+    public async Task TestSystemExplorerImportCompletionWarmedByPublicDocumentDiagnostics(bool mutatingLspWorkspace)
+    {
+        var markup =
+            """
+            namespace Hidden.Project
+            {
+                public class HiddenController
+                {
+                }
+            }
+
+            namespace Consumer
+            {
+                class C
+                {
+                    Hidd{|caret:|}
+                }
+            }
+            """;
+        var capabilities = CreateCoreCompletionCapabilities();
+        capabilities.SystemExplorerSupportsImportCompletion = true;
+
+        await using var testLspServer = await CreateTestLspServerAsync(markup, mutatingLspWorkspace, capabilities);
+        testLspServer.TestWorkspace.GlobalOptions.SetGlobalOption(CompletionOptionsStorage.ShowItemsFromUnimportedNamespaces, LanguageNames.CSharp, true);
+        testLspServer.TestWorkspace.GlobalOptions.SetGlobalOption(CompletionOptionsStorage.ForceExpandedCompletionIndexCreation, false);
+
+        var caretLocation = testLspServer.GetLocations("caret").Single();
+        await testLspServer.OpenDocumentAsync(caretLocation.DocumentUri);
+
+        _ = await testLspServer.ExecuteRequestAsync<
+            LSP.DocumentDiagnosticParams,
+            SumType<LSP.FullDocumentDiagnosticReport, LSP.UnchangedDocumentDiagnosticReport>>(
+                LSP.Methods.TextDocumentDiagnosticName,
+                new LSP.DocumentDiagnosticParams
+                {
+                    TextDocument = new LSP.TextDocumentIdentifier { DocumentUri = caretLocation.DocumentUri },
+                },
+                CancellationToken.None).ConfigureAwait(false);
+
+        var completionParams = CreateCompletionParams(
+            caretLocation,
+            invokeKind: LSP.VSInternalCompletionInvokeKind.Explicit,
+            triggerCharacter: "\0",
+            triggerKind: LSP.CompletionTriggerKind.Invoked);
+
+        var results = await RunGetCompletionsAsync(testLspServer, completionParams).ConfigureAwait(false);
+        var item = Assert.IsType<LSP.VSInternalCompletionItem>(results.Items.Single(item => item.Label == "HiddenController"));
+        Assert.Equal(LSP.CompletionItemKind.Class, item.Kind);
+        Assert.True(item.VsResolveTextEditOnCommit);
+        Assert.True(item.SystemExplorerCompletionRequiresImport);
+        Assert.Equal("OtherUserCode", item.SystemExplorerCompletionSemanticOrigin);
+        Assert.Null(item.SystemExplorerCompletionInheritanceDepth);
+    }
