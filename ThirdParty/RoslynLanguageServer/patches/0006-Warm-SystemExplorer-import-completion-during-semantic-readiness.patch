+
+    protected override async Task OnDiagnosticsComputedAsync(
+        DocumentDiagnosticParams diagnosticsParams, RequestContext context, CancellationToken cancellationToken)
+    {
+        var capabilityHelper = new CompletionCapabilityHelper(context.GetRequiredClientCapabilities());
+        if (!capabilityHelper.SupportSystemExplorerImportCompletion)
+            return;
+
+        if (diagnosticsParams.TextDocument is not { } textDocument
+            || !context.IsTracking(textDocument.DocumentUri)
+            || context.TextDocument is not Document document
+            || document.Project.Language != LanguageNames.CSharp)
+        {
+            return;
+        }
+
+        var completionService = CompletionService.GetService(document);
+        if (completionService is null)
+            return;
+
+        context.TraceDebug("SystemExplorer import completion readiness warm-up started");
+        try
+        {
+            var completionOptions = GlobalOptions.GetCompletionOptionsForLsp(
+                document.Project.Language, capabilityHelper);
+            await completionService.WarmUpForSystemExplorerImportCompletionAsync(
+                document.Project, completionOptions, cancellationToken).ConfigureAwait(false);
+            context.TraceDebug("SystemExplorer import completion readiness warm-up completed");
+        }
+        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
+        {
+            throw;
+        }
+        catch (Exception exception)
+        {
+            context.TraceWarning($"SystemExplorer import completion readiness warm-up failed: {exception.GetType().Name}");
+        }
+    }
 }
