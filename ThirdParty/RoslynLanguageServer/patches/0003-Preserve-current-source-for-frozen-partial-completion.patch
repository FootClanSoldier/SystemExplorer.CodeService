+    /// <summary>
+    /// Creates a completion-specific frozen-partial solution from the current compilation state.  The ordinary
+    /// frozen-solution/document caches remain legacy caches; the completion-specific result is never cached into
+    /// either of them because it has a stronger current-source contract.
+    /// </summary>
+    internal Solution WithFrozenPartialCompilationIncludingSpecificDocumentForCompletion(
+        DocumentId documentId, CancellationToken cancellationToken)
+    {
+        var newCompilationState = CompilationState.WithFrozenPartialCompilationIncludingSpecificDocumentForCompletion(
+            documentId, cancellationToken);
+
+        if (newCompilationState == CompilationState)
+            return this;
+
+        // Deliberately do not pass either legacy frozen cache to this Solution.  The underlying compilation-state
+        // freeze may reuse its immutable compiler-state capture, but current ordinary source is reapplied before the
+        // completion-specific state is returned.
+        return new Solution(newCompilationState);
+    }
