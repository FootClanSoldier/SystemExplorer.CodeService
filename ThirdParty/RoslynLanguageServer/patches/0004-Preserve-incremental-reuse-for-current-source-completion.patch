+    /// <summary>
+    /// Creates a completion-specific frozen snapshot.  The requesting project and its same-language transitive
+    /// compilation dependencies preserve existing in-progress translation chains; all other projects retain the
+    /// legacy frozen-partial policy.  This snapshot is intentionally not stored in the legacy frozen cache.
+    /// </summary>
+    private SolutionCompilationState WithFrozenPartialCompilationsForCompletion(
+        ProjectId requestingProjectId, CancellationToken cancellationToken)
+    {
+        var (sortedNewProjectStates, newIdToTrackerMap) = ComputeFrozenSnapshotMapsForCompletion(
+            requestingProjectId, cancellationToken);
+
+        var dependencyGraph = SolutionState.CreateDependencyGraph(this.SolutionState.ProjectIds, sortedNewProjectStates);
+        var newState = this.SolutionState.Branch(
+            projectStates: sortedNewProjectStates,
+            dependencyGraph: dependencyGraph);
+
+        return this.Branch(newState, newIdToTrackerMap);
+    }
+
+    private (ImmutableArray<ProjectState> sortedProjectStates, ImmutableSegmentedDictionary<ProjectId, ICompilationTracker>)
+        ComputeFrozenSnapshotMapsForCompletion(ProjectId requestingProjectId, CancellationToken cancellationToken)
+    {
+        var requestingProjectState = this.SolutionState.GetRequiredProjectState(requestingProjectId);
+        var dependencyGraph = this.SolutionState.GetProjectDependencyGraph();
+        var transitiveDependencies = dependencyGraph.GetProjectsThatThisProjectTransitivelyDependsOn(requestingProjectId);
+
+        // Keep the same tracker-map stabilization loop as the legacy freeze, but opt only the completion-relevant
+        // same-language project closure into the stronger in-progress preservation policy.
+        while (true)
+        {
+            var originalProjectIdToTrackerMap = _projectIdToTrackerMap;
+            var newIdToTrackerMapBuilder = originalProjectIdToTrackerMap.ToBuilder();
+            var projectStateChanged = false;
+            using var _ = ArrayBuilder<ProjectState>.GetInstance(this.SolutionState.SortedProjectStates.Length, out var newSortedProjectStatesBuilder);
+            newSortedProjectStatesBuilder.AddRange(this.SolutionState.SortedProjectStates);
+
+            var updatedIdToTrackerMapBuilder = originalProjectIdToTrackerMap.ToBuilder();
+            for (var i = 0; i < newSortedProjectStatesBuilder.Count; i++)
+            {
+                var projectId = newSortedProjectStatesBuilder[i].Id;
+                cancellationToken.ThrowIfCancellationRequested();
+
+                var oldProjectState = this.SolutionState.GetRequiredProjectState(projectId);
+                if (!oldProjectState.SupportsCompilation)
+                    continue;
+
+                if (!originalProjectIdToTrackerMap.TryGetValue(projectId, out var oldTracker))
+                {
+                    oldTracker = CreateCompilationTracker(projectId, this.SolutionState);
+                    updatedIdToTrackerMapBuilder[projectId] = oldTracker;
+                }
+
+                var useCompletionPolicy =
+                    (projectId == requestingProjectId || transitiveDependencies.Contains(projectId)) &&
+                    oldProjectState.LanguageServices == requestingProjectState.LanguageServices;
+
+                var newTracker = useCompletionPolicy
+                    ? oldTracker.WithDoNotCreateCreationPolicyForCompletion()
+                    : oldTracker.WithDoNotCreateCreationPolicy();
+
+                if (oldTracker == newTracker)
+                    continue;
+
+                newSortedProjectStatesBuilder[i] = newTracker.ProjectState;
+                newIdToTrackerMapBuilder[projectId] = newTracker;
+                projectStateChanged = true;
+            }
+
+            var updatedIdToTrackerMap = updatedIdToTrackerMapBuilder.ToImmutable();
+            if (originalProjectIdToTrackerMap == RoslynImmutableInterlocked.InterlockedCompareExchange(
+                ref _projectIdToTrackerMap, updatedIdToTrackerMap, originalProjectIdToTrackerMap))
+            {
+                var newProjectStates = projectStateChanged
+                    ? newSortedProjectStatesBuilder.ToImmutableAndClear()
+                    : this.SolutionState.SortedProjectStates;
+                return (newProjectStates, newIdToTrackerMapBuilder.ToImmutable());
+            }
+        }
+    }
