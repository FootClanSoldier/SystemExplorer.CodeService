+﻿// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System.Collections.Immutable;
+using System.Threading;
+
+namespace Microsoft.CodeAnalysis.Completion;
+
+public abstract partial class CompletionService
+{
+    private SystemExplorerCompletionSourcePathExclusions _systemExplorerCompletionSourcePathExclusions =
+        SystemExplorerCompletionSourcePathExclusions.Empty;
+
+    internal void ConfigureSystemExplorerCompletionExcludedPathPrefixes(ImmutableArray<string> excludedPathPrefixes)
+    {
+        var currentExclusions = Volatile.Read(ref _systemExplorerCompletionSourcePathExclusions);
+        if (currentExclusions.MatchesNormalizedPrefixes(excludedPathPrefixes))
+            return;
+
+        var newExclusions = new SystemExplorerCompletionSourcePathExclusions(excludedPathPrefixes);
+        if (currentExclusions.IsEquivalentTo(newExclusions))
+            return;
+
+        Volatile.Write(ref _systemExplorerCompletionSourcePathExclusions, newExclusions);
+    }
+
+    internal SystemExplorerCompletionSourcePathExclusions GetSystemExplorerCompletionSourcePathExclusionsSnapshot()
+        => Volatile.Read(ref _systemExplorerCompletionSourcePathExclusions);
+
+    private Document? GetSystemExplorerCompletionSourceDocument(
+        Document document,
+        SystemExplorerCompletionSourcePathExclusions exclusions,
+        CancellationToken cancellationToken)
+    {
+        var projectedSolution = document.Project.Solution.WithSystemExplorerCompletionSourceExclusions(exclusions, cancellationToken);
+        return projectedSolution.GetDocument(document.Id);
+    }
+
+    private Project? GetSystemExplorerCompletionSourceProject(
+        Project project,
+        SystemExplorerCompletionSourcePathExclusions exclusions,
+        CancellationToken cancellationToken)
+    {
+        var projectedSolution = project.Solution.WithSystemExplorerCompletionSourceExclusions(exclusions, cancellationToken);
+        return projectedSolution.GetProject(project.Id);
+    }
+}
