-using System;
-using System.Collections.Immutable;
-using System.IO;
-using System.Linq;
-
-namespace Microsoft.CodeAnalysis.Completion.Providers;
-
-/// <summary>
-/// Private SystemExplorer filter for excluding source-backed types from the type import completion cache.
-/// Expensive path normalization is completed by the language-server initialize path before reaching this type.
-/// </summary>
-internal sealed class SystemExplorerImportCompletionPathFilter
-{
-    private const string ChecksumIdentity = "SystemExplorerImportCompletionPathFilter/v1";
-
-    private static readonly StringComparison s_pathComparison =
-        Path.DirectorySeparatorChar == '\\' ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;
-
-    private static readonly StringComparer s_pathComparer =
-        Path.DirectorySeparatorChar == '\\' ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal;
-
-    public static readonly SystemExplorerImportCompletionPathFilter Empty = new([]);
-
-    private readonly ImmutableArray<string> _excludedPathPrefixes;
-
-    public Checksum Checksum { get; }
-
-    public SystemExplorerImportCompletionPathFilter(ImmutableArray<string> excludedPathPrefixes)
-    {
-        if (excludedPathPrefixes.IsDefault)
-            throw new ArgumentException("Excluded path prefixes must be initialized.", nameof(excludedPathPrefixes));
-
-        // The initialize path already supplies normalized values. Canonicalize set identity here as well so
-        // callers of the language-service configuration API cannot make ordering or duplicates semantically meaningful.
-        _excludedPathPrefixes = excludedPathPrefixes
-            .Distinct(s_pathComparer)
-            .OrderBy(static prefix => prefix, s_pathComparer)
-            .ToImmutableArray();
-
-        Checksum = CreateChecksum(_excludedPathPrefixes);
-    }
-
-    public bool MatchesNormalizedPrefixes(ImmutableArray<string> excludedPathPrefixes)
-    {
-        if (excludedPathPrefixes.IsDefault || excludedPathPrefixes.Length != _excludedPathPrefixes.Length)
-            return false;
-
-        for (var i = 0; i < _excludedPathPrefixes.Length; i++)
-        {
-            if (!s_pathComparer.Equals(_excludedPathPrefixes[i], excludedPathPrefixes[i]))
-                return false;
-        }
-
-        return true;
-    }
-
-    public bool IsEquivalentTo(SystemExplorerImportCompletionPathFilter other)
-    {
-        if (Checksum != other.Checksum || _excludedPathPrefixes.Length != other._excludedPathPrefixes.Length)
-            return false;
-
-        for (var i = 0; i < _excludedPathPrefixes.Length; i++)
-        {
-            if (!s_pathComparer.Equals(_excludedPathPrefixes[i], other._excludedPathPrefixes[i]))
-                return false;
-        }
-
-        return true;
-    }
-
-    public bool IsExcluded(INamedTypeSymbol type)
-    {
-        if (_excludedPathPrefixes.IsEmpty)
-            return false;
-
-        var hasSourceDeclaration = false;
-        foreach (var location in type.Locations)
-        {
-            if (!location.IsInSource)
-                continue;
-
-            hasSourceDeclaration = true;
-            var sourcePath = location.SourceTree?.FilePath;
-
-            // A source declaration without a usable path makes the whole type fail open.
-            if (string.IsNullOrEmpty(sourcePath) || !IsExcludedSourcePath(sourcePath))
-                return false;
-        }
-
-        return hasSourceDeclaration;
-    }
-
-    private bool IsExcludedSourcePath(string sourcePath)
-    {
-        foreach (var excludedPathPrefix in _excludedPathPrefixes)
-        {
-            if (sourcePath.StartsWith(excludedPathPrefix, s_pathComparison))
-                return true;
-        }
-
-        return false;
-    }
-
-    private static Checksum CreateChecksum(ImmutableArray<string> excludedPathPrefixes)
-    {
-        // Include an explicit private-filter identity so the empty set also has a stable, domain-specific checksum.
-        // OrdinalIgnoreCase is semantic identity on Windows, so case-fold only checksum input there.
-        var checksumValues = s_pathComparison == StringComparison.OrdinalIgnoreCase
-            ? excludedPathPrefixes.Select(static prefix => prefix.ToUpperInvariant()).Prepend(ChecksumIdentity)
-            : excludedPathPrefixes.Prepend(ChecksumIdentity);
-
-        return Microsoft.CodeAnalysis.Checksum.Create(checksumValues);
-    }
-}
