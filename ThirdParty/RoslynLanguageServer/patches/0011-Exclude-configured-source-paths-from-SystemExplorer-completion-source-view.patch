+﻿// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System.Collections.Generic;
+using System.Collections.Immutable;
+using System.Threading;
+using Roslyn.Utilities;
+
+namespace Microsoft.CodeAnalysis;
+
+public partial class Solution
+{
+    /// <summary>
+    /// Completion-only source projections for this immutable Solution snapshot, keyed by exclusion-set identity.
+    /// This cache is intentionally separate from both frozen-partial caches.  A new immutable Solution snapshot gets
+    /// a fresh cache, while a projected Solution is seeded with its own checksum so projection-of-projection is a no-op.
+    /// </summary>
+    private readonly Dictionary<Checksum, AsyncLazy<Solution>> _systemExplorerCompletionSourceProjectionCache = [];
+
+    internal Solution WithSystemExplorerCompletionSourceExclusions(
+        SystemExplorerCompletionSourcePathExclusions exclusions,
+        CancellationToken cancellationToken)
+    {
+        if (exclusions.IsEmpty)
+            return this;
+
+        return GetLazyProjection().GetValue(cancellationToken);
+
+        AsyncLazy<Solution> GetLazyProjection()
+        {
+            lock (_systemExplorerCompletionSourceProjectionCache)
+            {
+                if (!_systemExplorerCompletionSourceProjectionCache.TryGetValue(exclusions.Checksum, out var lazySolution))
+                {
+                    lazySolution = CreateLazyProjection(this, exclusions);
+                    _systemExplorerCompletionSourceProjectionCache.Add(exclusions.Checksum, lazySolution);
+                }
+
+                return lazySolution;
+            }
+        }
+
+        static AsyncLazy<Solution> CreateLazyProjection(
+            Solution solution,
+            SystemExplorerCompletionSourcePathExclusions exclusions)
+            => AsyncLazy.Create(
+                synchronousComputeFunction: static (arg, cancellationToken) =>
+                    ComputeProjection(arg.solution, arg.exclusions, cancellationToken),
+                arg: (solution, exclusions));
+
+        static Solution ComputeProjection(
+            Solution solution,
+            SystemExplorerCompletionSourcePathExclusions exclusions,
+            CancellationToken cancellationToken)
+        {
+            var documentIdsToRemove = ImmutableArray.CreateBuilder<DocumentId>();
+
+            foreach (var projectState in solution.SolutionState.SortedProjectStates)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+
+                foreach (var (documentId, documentState) in projectState.DocumentStates.States)
+                {
+                    cancellationToken.ThrowIfCancellationRequested();
+                    if (exclusions.IsExcludedSourcePath(documentState.FilePath))
+                        documentIdsToRemove.Add(documentId);
+                }
+            }
+
+            if (documentIdsToRemove.Count == 0)
+                return solution;
+
+            var projectedSolution = solution.RemoveDocuments(documentIdsToRemove.ToImmutable());
+
+            lock (projectedSolution._systemExplorerCompletionSourceProjectionCache)
+            {
+                Contract.ThrowIfTrue(projectedSolution._systemExplorerCompletionSourceProjectionCache.ContainsKey(exclusions.Checksum));
+                projectedSolution._systemExplorerCompletionSourceProjectionCache.Add(
+                    exclusions.Checksum,
+                    AsyncLazy.Create(projectedSolution));
+            }
+
+            return projectedSolution;
+        }
+    }
+}
