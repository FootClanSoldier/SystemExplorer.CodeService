+    [Fact]
+    public async Task CompletionSemanticOriginUsesExplicitReceiverTypeForMemberAccess()
+    {
+        var completionList = await GetSystemExplorerCompletionListAsync("""
+            class ReceiverBase2
+            {
+                public void DeepMember() { }
+            }
+
+            class ReceiverBase1 : ReceiverBase2
+            {
+                public void NearMember() { }
+            }
+
+            class Player : ReceiverBase1
+            {
+                public void OwnMember() { }
+            }
+
+            class UnrelatedLexicalType
+            {
+                void M(Player p)
+                {
+                    p.$$
+                }
+            }
+            """);
+
+        AssertSystemExplorerCompletionEvidence(completionList, "OwnMember", "CurrentType", "0");
+        AssertSystemExplorerCompletionEvidence(completionList, "NearMember", "BaseType", "1");
+        AssertSystemExplorerCompletionEvidence(completionList, "DeepMember", "BaseType", "2");
+        AssertSystemExplorerCompletionEvidence(completionList, "GetType", "BaseType", "3");
+    }
+
