+    private static ImmutableArray<string> ParseSystemExplorerImportCompletionExcludedPathPrefixes(object? initializationOptions)
+    {
+        if (initializationOptions is null)
+            return [];
+
+        var initializationOptionsElement = initializationOptions is JsonElement jsonElement
+            ? jsonElement
+            : JsonSerializer.SerializeToElement(initializationOptions);
+
+        if (initializationOptionsElement.ValueKind != JsonValueKind.Object
+            || !initializationOptionsElement.TryGetProperty(SystemExplorerImportCompletionExcludedPathPrefixesPropertyName, out var prefixesElement))
+        {
+            return [];
+        }
+
+        if (prefixesElement.ValueKind != JsonValueKind.Array)
+            throw CreateInvalidSystemExplorerImportCompletionExcludedPathPrefixesException("the property must be a JSON array");
+
+        var prefixCount = prefixesElement.GetArrayLength();
+        if (prefixCount is < 1 or > MaxSystemExplorerImportCompletionExcludedPathPrefixes)
+        {
+            throw CreateInvalidSystemExplorerImportCompletionExcludedPathPrefixesException(
+                $"the array must contain between 1 and {MaxSystemExplorerImportCompletionExcludedPathPrefixes} paths");
+        }
+
+        var pathComparer = Path.DirectorySeparatorChar == '\\' ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal;
+        var normalizedPrefixes = new HashSet<string>(pathComparer);
+
+        foreach (var prefixElement in prefixesElement.EnumerateArray())
+        {
+            if (prefixElement.ValueKind != JsonValueKind.String)
+                throw CreateInvalidSystemExplorerImportCompletionExcludedPathPrefixesException("every array entry must be a JSON string");
+
+            var prefix = prefixElement.GetString();
+            if (string.IsNullOrEmpty(prefix))
+                throw CreateInvalidSystemExplorerImportCompletionExcludedPathPrefixesException("paths must be non-empty");
+
+            if (prefix.Length > MaxSystemExplorerImportCompletionExcludedPathLength)
+            {
+                throw CreateInvalidSystemExplorerImportCompletionExcludedPathPrefixesException(
+                    $"paths must not exceed {MaxSystemExplorerImportCompletionExcludedPathLength} characters");
+            }
+
+            if (!IsSystemExplorerImportCompletionFullyQualifiedPath(prefix))
+                throw CreateInvalidSystemExplorerImportCompletionExcludedPathPrefixesException("paths must be fully-qualified absolute filesystem paths");
+
+            string fullPath;
+            try
+            {
+                fullPath = Path.GetFullPath(prefix);
+            }
+            catch (Exception exception) when (exception is ArgumentException or NotSupportedException or IOException)
+            {
+                throw CreateInvalidSystemExplorerImportCompletionExcludedPathPrefixesException("a path could not be normalized", exception);
+            }
+
+            var normalizedPrefix = fullPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
