--- /dev/null
+++ b/src/Features/Core/Portable/Completion/Providers/SystemExplorerCompletionContainingNamespace.cs
@@ -0,0 +1,53 @@
+﻿// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System.Collections.Immutable;
+
+namespace Microsoft.CodeAnalysis.Completion.Providers;
+
+internal static class SystemExplorerCompletionContainingNamespace
+{
+    internal const string ContainingNamespacePropertyKey = "SystemExplorer.CompletionContainingNamespace";
+
+    public static CompletionItem Attach(
+        CompletionItem item,
+        ImmutableArray<ISymbol> symbols)
+    {
+        if (symbols.IsDefaultOrEmpty)
+            return item;
+
+        INamespaceSymbol? containingNamespace = null;
+        foreach (var symbol in symbols)
+        {
+            if (symbol is not INamedTypeSymbol namedType)
+                return item;
+
+            var currentContainingNamespace = namedType.ContainingNamespace;
+            if (currentContainingNamespace.IsGlobalNamespace)
+                return item;
+
+            if (containingNamespace is null)
+            {
+                containingNamespace = currentContainingNamespace;
+            }
+            else if (!SymbolEqualityComparer.Default.Equals(containingNamespace, currentContainingNamespace))
+            {
+                return item;
+            }
+        }
+
+        if (containingNamespace is null)
+            return item;
+
+        return Attach(item, containingNamespace.ToDisplayString());
+    }
+
+    public static CompletionItem Attach(CompletionItem item, string containingNamespace)
+    {
+        if (string.IsNullOrEmpty(containingNamespace))
+            return item;
+
+        return item.AddProperty(ContainingNamespacePropertyKey, containingNamespace);
+    }
+}
