+    [Fact]
+    public void WithFrozenPartialSemanticsForCompletionRestoresCurrentProjectDocumentsAfterLegacyFreeze()
+    {
+        using var workspace = WorkspaceTestUtilities.CreateWorkspaceWithPartialSemantics();
+
+        var project = SolutionUtilities.AddEmptyProject(workspace.CurrentSolution)
+            .AddDocument("Target.cs", SourceText.From("class Target { public int CurrentMember { get; } }"), filePath: "Target.cs").Project
+            .AddDocument("Consumer.cs", SourceText.From("class Consumer { void M(Target target) { target.ToString(); } }"), filePath: "Consumer.cs").Project;
+
+        var consumerDocument = project.Documents.Single(static document => document.Name == "Consumer.cs");
+
+        // Populate and inspect the legacy frozen snapshot first.  On this cold path it only restores the requesting
+        // document, so Target.cs is absent.  The completion-specific API must not reuse that legacy snapshot as its
+        // final state; it must restore the current ordinary source closure from the current SolutionCompilationState.
+        var legacyDocument = consumerDocument.WithFrozenPartialSemantics(CancellationToken.None);
+        var legacyProjectDocuments = legacyDocument.Project.Documents.Select(static document => document.Name).ToImmutableHashSet();
+
+        Assert.Contains("Consumer.cs", legacyProjectDocuments);
+        Assert.DoesNotContain("Target.cs", legacyProjectDocuments);
+
+        var completionDocument = consumerDocument.WithFrozenPartialSemanticsForCompletion(CancellationToken.None);
+        var completionProjectDocuments = completionDocument.Project.Documents.Select(static document => document.Name).ToImmutableHashSet();
+
+        Assert.Contains("Consumer.cs", completionProjectDocuments);
+        Assert.Contains("Target.cs", completionProjectDocuments);
+        Assert.Equal(2, completionProjectDocuments.Count);
+    }
