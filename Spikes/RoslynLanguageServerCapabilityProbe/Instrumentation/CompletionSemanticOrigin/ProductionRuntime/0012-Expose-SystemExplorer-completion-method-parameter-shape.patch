+    [Theory, CombinatorialData]
+    public async Task TestSystemExplorerCompletionMethodParameterShapeAsync(bool mutatingLspWorkspace)
+    {
+        var markup =
+            """
+            class C
+            {
+                void Parameterless() { }
+                void WithParameter(int value) { }
+                void Mixed() { }
+                void Mixed(int value) { }
+                void GenericParameterless<T>() { }
+                void GenericWithParameter<T>(T value) { }
+                int Property { get; }
+                int Field;
+                class Nested { }
+
+                void Test()
+                {
+                    this.{|caret:|}
+                }
+
+                void TypeTest()
+                {
+                    Nes{|typeCaret:|}
+                }
+            }
+            """;
+
+        await using var testLspServer = await CreateTestLspServerAsync(markup, mutatingLspWorkspace, s_vsCompletionCapabilities);
+        var completionParams = CreateCompletionParams(
+            testLspServer.GetLocations("caret").Single(),
+            invokeKind: LSP.VSInternalCompletionInvokeKind.Explicit,
+            triggerCharacter: "\0",
+            triggerKind: LSP.CompletionTriggerKind.Invoked);
+
+        var results = await RunGetCompletionsAsync(testLspServer, completionParams).ConfigureAwait(false);
+
+        var parameterless = Assert.IsType<LSP.VSInternalCompletionItem>(results.Items.Single(item => item.Label == "Parameterless"));
+        Assert.False(Assert.IsType<bool>(parameterless.SystemExplorerCompletionMethodHasParameters));
+
+        var withParameter = Assert.IsType<LSP.VSInternalCompletionItem>(results.Items.Single(item => item.Label == "WithParameter"));
+        Assert.True(Assert.IsType<bool>(withParameter.SystemExplorerCompletionMethodHasParameters));
+
+        var mixed = Assert.IsType<LSP.VSInternalCompletionItem>(results.Items.Single(item => item.Label == "Mixed"));
+        Assert.True(Assert.IsType<bool>(mixed.SystemExplorerCompletionMethodHasParameters));
+
+        var genericParameterless = Assert.IsType<LSP.VSInternalCompletionItem>(results.Items.Single(item => item.Label == "GenericParameterless<>"));
+        Assert.False(Assert.IsType<bool>(genericParameterless.SystemExplorerCompletionMethodHasParameters));
+
+        var genericWithParameter = Assert.IsType<LSP.VSInternalCompletionItem>(results.Items.Single(item => item.Label == "GenericWithParameter<>"));
+        Assert.True(Assert.IsType<bool>(genericWithParameter.SystemExplorerCompletionMethodHasParameters));
+
+        var property = Assert.IsType<LSP.VSInternalCompletionItem>(results.Items.Single(item => item.Label == "Property"));
+        Assert.Null(property.SystemExplorerCompletionMethodHasParameters);
+
+        var field = Assert.IsType<LSP.VSInternalCompletionItem>(results.Items.Single(item => item.Label == "Field"));
+        Assert.Null(field.SystemExplorerCompletionMethodHasParameters);
+
+        var typeCompletionParams = CreateCompletionParams(
+            testLspServer.GetLocations("typeCaret").Single(),
+            invokeKind: LSP.VSInternalCompletionInvokeKind.Explicit,
+            triggerCharacter: "\0",
+            triggerKind: LSP.CompletionTriggerKind.Invoked);
+        var typeResults = await RunGetCompletionsAsync(testLspServer, typeCompletionParams).ConfigureAwait(false);
+        var type = Assert.IsType<LSP.VSInternalCompletionItem>(typeResults.Items.Single(item => item.Label == "Nested"));
+        Assert.Null(type.SystemExplorerCompletionMethodHasParameters);
+
+        var serialized = JsonSerializer.Serialize(
+            new LSP.OptimizedVSCompletionList((LSP.VSInternalCompletionList)results),
+            ProtocolConversions.LspJsonSerializerOptions);
+        Assert.Contains("\"_systemExplorer_completionMethodHasParameters\":false", serialized);
+        Assert.Contains("\"_systemExplorer_completionMethodHasParameters\":true", serialized);
+    }
