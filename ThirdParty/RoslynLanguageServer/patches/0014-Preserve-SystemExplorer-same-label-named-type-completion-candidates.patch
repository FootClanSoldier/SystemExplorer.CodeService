+    private static ImmutableArray<ImmutableArray<SymbolAndSelectionInfo>> SplitSystemExplorerSameLabelNamedTypeCandidates(
+        ImmutableArray<ImmutableArray<SymbolAndSelectionInfo>> symbolLists)
+    {
+        using var _ = ArrayBuilder<ImmutableArray<SymbolAndSelectionInfo>>.GetInstance(out var resultBuilder);
+
+        foreach (var symbolList in symbolLists)
+        {
+            if (symbolList.Length <= 1)
+            {
+                resultBuilder.Add(symbolList);
+                continue;
+            }
+
+            var canSplit = true;
+            foreach (var entry in symbolList)
+            {
+                if (entry.Symbol is not INamedTypeSymbol namedType || namedType.ContainingNamespace.IsGlobalNamespace)
+                {
+                    canSplit = false;
+                    break;
+                }
+            }
+
+            if (!canSplit)
+            {
+                resultBuilder.Add(symbolList);
+                continue;
+            }
+
+            var namespaceGroups = symbolList
+                .GroupBy(
+                    static entry => ((INamedTypeSymbol)entry.Symbol).ContainingNamespace.ToDisplayString(),
+                    StringComparer.Ordinal)
+                .Select(static group => group.ToImmutableArray())
+                .ToImmutableArray();
+
+            if (namespaceGroups.Length <= 1)
+            {
+                resultBuilder.Add(symbolList);
+                continue;
+            }
+
+            foreach (var namespaceGroup in namespaceGroups)
+                resultBuilder.Add(namespaceGroup);
+        }
+
+        return resultBuilder.ToImmutableAndClear();
+    }
+
